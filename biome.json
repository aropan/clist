{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "*.json",
      "src/static/js/**/*.js",
      "src/static/css/**/*.css",
      "!src/static/js/i18n",
      "!src/static/**/*.min.js",
      "!src/static/**/*.min.css",
      "!src/static/js/AddCalEvent.js",
      "!src/static/js/daterangepicker.js",
      "!src/static/js/ie-emulation-modes-warning.js",
      "!src/static/js/jquery.timeago.js",
      "!src/static/js/toastify.js",
      "!src/static/css/AddCalEvent.css",
      "!src/static/css/awesome-bootstrap-checkbox.css",
      "!src/static/css/bootstrap-editable.css",
      "!src/static/css/bootstrap-input-xs.css",
      "!src/static/css/bootstrap-left-right-below-tabs.css",
      "!src/static/css/BootstrapXL.css",
      "!src/static/css/daterangepicker-bs3.css",
      "!src/static/css/lightrope.css",
      "!src/static/css/tastypie_swagger.css"
    ]
  },
  "linter": {
    "enabled": false
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  }
}

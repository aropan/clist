{
    "name": "clist/clist",
    "description": "Development tools for the CLIST legacy PHP application.",
    "license": "Apache-2.0",
    "type": "project",
    "require": {
        "php": "^8.0"
    },
    "require-dev": {
        "php-cs-fixer/shim": "3.95.15"
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "check:php": "php-cs-fixer check --config=.php-cs-fixer.dist.php",
        "format:php": "php-cs-fixer fix --config=.php-cs-fixer.dist.php"
    }
}

          "defaultAi": false,
          "delayRedirectRankingWhenFinished": 0,
          "descriptionJson": "{\"showWorkIncentive\":true,\"noCountDown\":false,\"challengeInfo\":\"Major Community Event\",\"challengeTitle\":\" CodinGame Spring Challenge 2025\",\"contestDescription\":\"Spring Challenge 2025\",\"communityBanner\":{\"text\":\"Enjoy the sheer fun of coding in a game environment along with peers, friends and colleagues\",\"title\":\"A Community Event to Learn and Code while Having Fun\"},\"challengeOptions\":[{\"iconId\":1,\"valid\":true,\"title\":\"<strong>Open for 11 days</strong>\",\"fillColor\":\"#f2bb13\"},{\"iconId\":2,\"valid\":true,\"title\":\"<strong>Optimization puzzle</strong>\",\"fillColor\":\"#f2bb13\"},{\"iconId\":3,\"valid\":true,\"title\":\"<strong>Open to all</strong>\",\"fillColor\":\"#f2bb13\"},{\"iconId\":4,\"valid\":true,\"title\":\"<strong>3 leaderboards<br>Solo/Company/School</strong>\",\"fillColor\":\"#f2bb13\"},{\"iconId\":5,\"valid\":false,\"title\":\"25+ Programming Languages\",\"fillColor\":\"#f2bb13\"},{\"iconId\":6,\"valid\":true,\"title\":\"<strong>Crafted with ❤️</br>by CodinGame</strong>\",\"fillColor\":\"#f2bb13\"},{\"iconId\":7,\"title\":\"Fundraising for <strong>CoderDojo</strong>\",\"fillColor\":\"#f2bb13\"},{\"iconId\":8,\"valid\":false,\"title\":\"April 23rd at 18:00\",\"fillColor\":\"#f2bb13\"}],\"challengeDescription\":\"\",\"challengeTagLine\":{\"title\":\"Spring Challenge 2025\",\"description\":\"Join a fun & thrilling community event\"},\"howItWorksBlock\":\"Note: The use of workarounds to submit code compiled in a different language than the one selected is ground for disqualification from the final results. <br><br>The contest is over, but <a href='https://www.codingame.com/direct-puzzle/10438b4185abe3c3cf4df8fc899985a5a89ec'>you can keep playing here</a>!\",\"codinghub\":null,\"noSponsors\":null,\"showContestLogo\":true,\"charity\":null,\"hideTopRegisterButton\":null,\"customBlock\":null,\"videoCover\":null,\"videoTagline\":null,\"videoEmbedded\":null,\"startedDescription\":null,\"noStartDate\":null,\"style\":\"#contest .contest-info-video-tagline {\\n  color: #f2bb13;\\n  font-size: 42px;\\n  font-weight: 700;\\n  text-align: center;\\n  text-transform: uppercase;\\n}\\n#contest .contest-option-icon {\\n  fill-rule: evenodd;\\n  fill: #f2bb13;\\n}\\n\\n#contest .contest-content .contest-header {\\n  flex-direction: row;\\n}\\n\\n.contest-how-it-works-image-container {\\n  display: none;\\n}\\n\\n.contest-how-it-works {\\n  min-height: 0 !important;\\n}\\n\",\"challengeDate\":\"\",\"howTo\":{\"items\":[{\"text\":\"Participating in the event is free.\",\"title\":\"How much does it cost?\"},{\"text\":\"The event starts on October 3rd at 10am UTC and ends on October 10th at 10am UTC. It starts at the same time for all players in the world, whatever the time zone.\",\"title\":\"When does it start and end?\"},{\"text\":\"Yes, you need to create a CodinGame account before being able to register for the challenge. We also suggest having a look at easy puzzles to get used to the platform.\",\"title\":\"Do I need a CodinGame account to compete?\"},{\"text\":\"By default, if you've added your company to your profile, depending on your rank, you'll contribute to your company for the company leaderboard. In the same way, if you've added your school to your profile, depending on your rank, you'll contribute points to your school for the school leaderboard.  You can complete your <a href=\\\"/profile/\\\" target=\\\"_blank\\\" style=\\\"color:#f2bb13\\\">profile here</a>.\",\"title\":\"How can I compete for my school/company?\"},{\"text\":\"Only the top 100 schools and top 100 companies will be visible. Furthermore, it's possible to play the solo competition only.\",\"title\":\"I'm afraid of projecting a negative image of my school/company if I rank poorly. What can I do?\"},{\"text\":\"This is a optimization challenge. New in optimization? No worries, <a href=\\\"/multiplayer/optimization/code-vs-zombies\\\" target=\\\"_blank\\\" style=\\\"color:#f2bb13\\\">here's a guide for beginners</a>.\",\"title\":\"What type of coding exercise should I expect?\"},{\"text\":\"We take the sum of points of the top 5 players in each company/school with at least 3 players. More info in this <a href=\\\"/forum/t/codingame-spring-challenge-2020/152927/\\\" target=\\\"_blank\\\" style=\\\"color:#f2bb13\\\">forum's thread</a>.\",\"title\":\"How are the school/company leaderboards computed?\"},{\"text\":\"Copying code between players is forbidden during contests. We'll thoroughly monitor players' submissions and we reserve ourselves the right to ban any player in case of abuse.\",\"title\":\"What if people try to cheat the system or disturb the school/company leaderboards?\"}],\"title\":\"F.A.Q\"},\"prizes\":null,\"showUpdateButton\":null,\"endCta\":null,\"endCtaUrl\":null}",

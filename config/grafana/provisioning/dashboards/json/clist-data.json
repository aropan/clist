        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "clist-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  (SELECT count(*) FROM public.clist_resource) AS \"Resources\",\n  (SELECT count(*) FROM public.clist_contest) AS \"Contests\",\n  (SELECT count(*) FROM public.clist_problem) AS \"Problems\",\n  (SELECT reltuples::bigint FROM pg_class WHERE oid = 'public.ranking_account'::regclass) AS \"Accounts\",\n  (SELECT reltuples::bigint FROM pg_class WHERE oid = 'public.ranking_statistics'::regclass) AS \"Statistics\",\n  (SELECT count(*) FROM public.true_coders_coder) AS \"Coders\"",
          "refId": "A"
        }
      ],
      "title": "CLIST Objects",
      "type": "stat"
    },

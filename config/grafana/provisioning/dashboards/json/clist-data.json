      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "clist-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time, metric, value\nFROM (\n  SELECT $__timeGroupAlias(created, $__interval, 0), 'Resources' AS metric, count(created)::double precision AS value\n  FROM public.clist_resource\n  WHERE $__timeFilter(created)\n  GROUP BY 1\n  UNION ALL\n  SELECT $__timeGroupAlias(created, $__interval, 0), 'Problems' AS metric, count(created)::double precision AS value\n  FROM public.clist_problem\n  WHERE $__timeFilter(created)\n  GROUP BY 1\n  UNION ALL\n  SELECT $__timeGroupAlias(created, $__interval, 0), 'Accounts' AS metric, count(created)::double precision AS value\n  FROM public.ranking_account\n  WHERE $__timeFilter(created)\n  GROUP BY 1\n  UNION ALL\n  SELECT $__timeGroupAlias(created, $__interval, 0), 'Statistics' AS metric, count(created)::double precision AS value\n  FROM public.ranking_statistics\n  WHERE $__timeFilter(created)\n  GROUP BY 1\n  UNION ALL\n  SELECT $__timeGroupAlias(created, $__interval, 0), 'Coders' AS metric, count(created)::double precision AS value\n  FROM public.true_coders_coder\n  WHERE $__timeFilter(created)\n  GROUP BY 1\n) activity\nORDER BY time",
          "refId": "A"
        }
      ],
      "title": "Entities Created",
      "type": "timeseries"
    },

        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "clist-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  pg_database_size(current_database())::bigint AS \"Database size\",\n  (SELECT sum(n_live_tup)::bigint FROM pg_stat_user_tables) AS \"Estimated rows\",\n  (SELECT sum(n_dead_tup)::bigint FROM pg_stat_user_tables) AS \"Dead tuples\",\n  (SELECT round(100.0 * blks_hit / NULLIF(blks_hit + blks_read, 0), 2)::double precision FROM pg_stat_database WHERE datname = current_database()) AS \"Cache hit\",\n  (SELECT count(*)::bigint FROM pg_stat_activity WHERE datname = current_database()) AS \"Connections\"",
          "refId": "A"
        }
      ],
      "title": "Database Health",
      "type": "stat"

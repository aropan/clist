        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Mean seconds"
          }
        ]
      },
      "pluginVersion": "13.0.2",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "clist-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  name AS \"Event\",\n  count(*)::bigint AS \"Runs\",\n  count(*) FILTER (WHERE status IN ('failed', 'interrupted', 'warning'))::bigint AS \"Problems\",\n  round(avg(EXTRACT(EPOCH FROM elapsed)) FILTER (WHERE elapsed IS NOT NULL)::numeric, 2)::double precision AS \"Mean seconds\",\n  round((percentile_cont(0.95) WITHIN GROUP (ORDER BY EXTRACT(EPOCH FROM elapsed)) FILTER (WHERE elapsed IS NOT NULL))::numeric, 2)::double precision AS \"P95 seconds\",\n  round(max(EXTRACT(EPOCH FROM elapsed)) FILTER (WHERE elapsed IS NOT NULL)::numeric, 2)::double precision AS \"Max seconds\"\nFROM public.logify_eventlog\nWHERE $__timeFilter(created)\n  AND environment ~ '${environment:regex}'\nGROUP BY name\nORDER BY count(*) DESC\nLIMIT 15",
          "refId": "A"
        }
      ],
      "title": "Event Types",
      "type": "table"
    },

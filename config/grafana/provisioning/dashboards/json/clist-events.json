      "pluginVersion": "13.0.2",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "clist-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  created AS \"Time\",\n  name AS \"Event\",\n  status AS \"Status\",\n  round(EXTRACT(EPOCH FROM elapsed)::numeric, 2)::double precision AS \"Duration\",\n  environment AS \"Environment\"\nFROM public.logify_eventlog\nWHERE $__timeFilter(created)\n  AND environment ~ '${environment:regex}'\n  AND status ~ '${event_status:regex}'\nORDER BY created DESC\nLIMIT 100",
          "refId": "A"
        }
      ],

          "hideZeros": true,
          "mode": "single",
          "sort": "none"
        }
      },
      "pluginVersion": "13.0.2",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "clist-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  count(*) FILTER (WHERE status = 'completed')::bigint AS \"completed\",\n  count(*) FILTER (WHERE status = 'warning')::bigint AS \"warning\",\n  count(*) FILTER (WHERE status = 'failed')::bigint AS \"failed\",\n  count(*) FILTER (WHERE status = 'interrupted')::bigint AS \"interrupted\",\n  count(*) FILTER (WHERE status = 'in_progress')::bigint AS \"in_progress\",\n  count(*) FILTER (WHERE status = 'skipped')::bigint AS \"skipped\",\n  count(*) FILTER (WHERE status NOT IN ('completed', 'warning', 'failed', 'interrupted', 'in_progress', 'skipped'))::bigint AS \"other\"\nFROM public.logify_eventlog\nWHERE $__timeFilter(created)\n  AND environment ~ '${environment:regex}'",
          "refId": "A"
        }
      ],
      "title": "Event Status Distribution",
      "type": "piechart"
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "clist-postgres"

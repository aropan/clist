                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "warning"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "orange",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^(failed|interrupted)$/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "in_progress"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "blue",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^(none|skipped)$/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "gray",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "cancelled"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "purple",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 15,
        "w": 16,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "interval": "5m",
      "maxDataPoints": 300,
      "options": {
        "legend": {
          "calcs": [
            "sum",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "sortBy": "Total",
          "sortDesc": true
        },
        "tooltip": {
          "hideZeros": true,
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "13.0.2",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "clist-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroupAlias(created, $__interval, 0),\n  count(*) FILTER (WHERE status = 'none')::double precision AS \"none\",\n  count(*) FILTER (WHERE status = 'completed')::double precision AS \"completed\",\n  count(*) FILTER (WHERE status = 'failed')::double precision AS \"failed\",\n  count(*) FILTER (WHERE status = 'in_progress')::double precision AS \"in_progress\",\n  count(*) FILTER (WHERE status = 'cancelled')::double precision AS \"cancelled\",\n  count(*) FILTER (WHERE status = 'skipped')::double precision AS \"skipped\",\n  count(*) FILTER (WHERE status = 'interrupted')::double precision AS \"interrupted\",\n  count(*) FILTER (WHERE status = 'warning')::double precision AS \"warning\"\nFROM public.logify_eventlog\nWHERE $__timeFilter(created)\n  AND environment ~ '${environment:regex}'\nGROUP BY 1\nORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Event Runs by Status",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "clist-postgres"
      },
      "description": "Status distribution for EventLog rows in the selected time range and environment.",
      "fieldConfig": {

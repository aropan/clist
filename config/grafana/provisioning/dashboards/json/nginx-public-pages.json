        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "direction": "backward",
          "editorMode": "code",
          "expr": "(\n  sum(count_over_time(\n    {service=\"nginx\", env=\"$env\", host=\"$host\", log_type=\"access\"}\n    | limit_req_status = \"REJECTED_DRY_RUN\"\n  [$__interval]))\n  or vector(0)\n) /\nsum(count_over_time(\n  {service=\"nginx\", env=\"$env\", host=\"$host\", log_type=\"access\"}\n    | limit_req_key =~ \"^/.*\"\n[$__interval]))",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Would-Be-Rejected Share",
      "type": "stat"
    },

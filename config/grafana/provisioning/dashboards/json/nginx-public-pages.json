    {
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "description": "Requests that carry a limit_req key, i.e. the GET traffic the dry-run policy actually watches.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": 0
              }
            ]
          },
          "decimals": 1,
          "unit": "suffix:req/min"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "id": 6,
      "interval": "1m",
      "maxDataPoints": 240,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "direction": "backward",
          "editorMode": "code",
          "expr": "sum(\n  rate(\n    {service=\"nginx\", env=\"$env\", host=\"$host\", log_type=\"access\"}\n    | limit_req_key =~ \"^/.*\"\n  [$__interval])\n) * 60",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Tracked Request Rate",
      "type": "stat"
    },
    {
